FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    wget \
    git \
    gccgo-10 \
    make \
    findutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copia tutto il codice (incluso vendor)
COPY . .

# Compila direttamente con gccgo, senza go build
RUN find . -name "*.go" -not -path "./.git/*" -print0 | xargs -0 gccgo-10 \
    -g -O2 \
    -march=i586 \
    -mno-mmx \
    -mno-sse \
    -static \
    -static-libgcc \
    -o MP48WebService

CMD ["./MP48WebService"]