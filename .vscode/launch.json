{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Portal (Debug)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "buildFlags": "-mod=vendor -gcflags=\"all=-N -l\"",
            "dlvPath": "/usr/local/go/bin/dlv",
            "dlvFlags": ["--check-go-version=false"],
            "env": {
                "GOOS": "linux",
                "GOARCH": "386",
                "GO386": "387",
                "CGO_ENABLED": "0",
                "GOROOT": "/usr/local/go",
                "GO111MODULE": "on"
            },
            "args": []
        },
        {
            "name": "Connect to dlv (Remote)",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "${workspaceFolder}",
            "port": 2345,
            "host": "127.0.0.1"
        }
    ]
}